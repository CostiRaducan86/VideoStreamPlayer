<Window x:Class="VilsSharpX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VILS SharpX" Width="1880" Height="1000" WindowStartupLocation="CenterScreen"
    UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <!-- Modern rounded corners style for all controls -->
        
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D0D0D0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                        Grid.Column="2"
                                        Focusable="false"
                                        IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                        ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="#ABADB3"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="20"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Margin="0" Background="Transparent">
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z"
                                                          Fill="#606060"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F5F5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                            IsHitTestVisible="False"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                            Margin="6,3,25,3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderThickness="1"
                                            BorderBrush="#ABADB3"
                                            CornerRadius="3"
                                            Margin="0,1,0,0">
                                        <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Border"
                                    Width="16"
                                    Height="16"
                                    Background="White"
                                    BorderBrush="#ABADB3"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,6,0">
                                <Path x:Name="CheckMark"
                                      Width="10"
                                      Height="10"
                                      Stretch="Fill"
                                      Stroke="#2C5AA0"
                                      StrokeThickness="2"
                                      Data="M 0,5 L 3,8 L 8,0"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="#F5F5F5"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0"
                                    Padding="6,4">
                                <ContentPresenter ContentSource="Header"
                                                TextElement.FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,0,1,1"
                                    CornerRadius="0,0,4,4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RepeatButton Style (for NumericUpDown arrows) -->
        <Style TargetType="RepeatButton">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C0C0C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- Top Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="#F5F5F5" Padding="2">
            <MenuItem Header="_File">
                <MenuItem Header="Open..." IsEnabled="False"/>
                <MenuItem Header="Save As..." IsEnabled="False"/>
                <Separator/>
                <MenuItem Header="Exit" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="Hardware Configuration" Click="MenuHardwareConfig_Click"/>
                <MenuItem Header="Application Settings" Click="MenuAppSettings_Click"/>
                <MenuItem Header="Ethernet Configuration" Click="MenuEthernetConfig_Click"/>
                <MenuItem Header="Camera Configuration" Click="MenuCameraConfig_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="3.5*" />
            </Grid.ColumnDefinitions>

        <!-- A (top, spans col 0+1) -->
        <Border x:Name="PaneA" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="AVTP Monitor / Generator" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblA" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoA" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgA" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgA_MouseMove" MouseLeave="ImgA_MouseLeave"/>

                        <Canvas x:Name="OvrA" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalA" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- B (middle-left: LVDS) -->
        <Border x:Name="PaneB" Grid.Row="1" Grid.Column="0" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4,4,6,4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="LVDS Monitor / Generator" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblB" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoB" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgB" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgB_MouseMove" MouseLeave="ImgB_MouseLeave"/>

                        <Canvas x:Name="OvrB" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalB" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- C (middle-right: Basler Camera) -->
        <Border x:Name="PaneC" Grid.Row="1" Grid.Column="1" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="6,4,4,4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold" Text="LSM Monitor" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblC" HorizontalAlignment="Center" Foreground="DimGray" />
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="LblRunInfoC" HorizontalAlignment="Right" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgC" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgC_MouseMove" MouseLeave="ImgC_MouseLeave"/>

                        <Canvas x:Name="OvrC" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalC" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- D (bottom, spans col 0+1: Comparison) -->
        <Border x:Name="PaneD" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="8" Margin="4" Padding="6" Background="#F0F0F0">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" FontWeight="Bold"><Run Text="Comparison Monitor ("/><Run x:Name="RunCompModeLabel" Text="LVDS-AVTP"/><Run Text=")"/></TextBlock>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LblD" HorizontalAlignment="Center" Foreground="DimGray" />

                <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#C0C0C0" BorderThickness="1" CornerRadius="2">
                    <Grid ClipToBounds="True">
                        <Image x:Name="ImgD" Stretch="Fill"
                              SnapsToDevicePixels="True"
                              RenderTransformOrigin="0,0"
                              RenderOptions.BitmapScalingMode="NearestNeighbor"
                              PreviewMouseWheel="Img_PreviewMouseWheel" MouseLeftButtonDown="Img_MouseLeftButtonDown" MouseLeftButtonUp="Img_MouseLeftButtonUp"
                              SizeChanged="Img_SizeChanged"
                              MouseMove="ImgD_MouseMove" MouseLeave="ImgD_MouseLeave"/>

                        <Canvas x:Name="OvrD" IsHitTestVisible="False" />

                        <Border x:Name="NoSignalD" Background="#808080" IsHitTestVisible="False" Visibility="Visible">
                            <TextBlock Text="Signal not available"
                                       Foreground="White" FontWeight="Bold" FontSize="28" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Right side: CAN/UART (spans rows 0-1: A + B/C) -->
        <GroupBox x:Name="SidebarCan" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Header="CAN/UART Monitor" Padding="8" Margin="4" Background="#F0F0F0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FBFBFB" BorderBrush="#D7D7D7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE946;" Foreground="#6F6F6F" Margin="0,0,8,0"/>
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Text="&#xE8A7;" Foreground="#6F6F6F"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnCanTabRawCan" Content="RawCan"
                                    Click="BtnCanTabRawCan_Click"
                                    FontSize="11" Padding="10,3" Margin="0,0,6,0"
                                    Background="#F6F6F6" Foreground="#444444"
                                    BorderBrush="#D8D8D8" BorderThickness="1"/>
                            <Button x:Name="BtnCanTabMonitor" Content="Monitor"
                                    Click="BtnCanTabMonitor_Click"
                                    FontSize="11" FontWeight="SemiBold" Padding="12,3" Margin="0,0,6,0"
                                    Background="#1EA6E6" Foreground="White"
                                    BorderBrush="#1EA6E6" BorderThickness="1"/>
                            <Button x:Name="BtnCanTabUart" Content="UartTransaction"
                                    Click="BtnCanTabUart_Click"
                                    FontSize="11" Padding="10,3"
                                    Background="#F6F6F6" Foreground="#444444"
                                    BorderBrush="#D8D8D8" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Order by:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                    <ComboBox x:Name="CmbCanOrderBy" Grid.Column="1" SelectedIndex="0" SelectionChanged="CmbCanFilters_SelectionChanged">
                        <ComboBoxItem Content="Nr"/>
                        <ComboBoxItem Content="Time"/>
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="Sort:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                    <ComboBox x:Name="CmbCanSort" Grid.Column="4" SelectedIndex="0" SelectionChanged="CmbCanFilters_SelectionChanged">
                        <ComboBoxItem Content="asc"/>
                        <ComboBoxItem Content="desc"/>
                    </ComboBox>

                    <TextBlock Grid.Column="6" Text="Select Device:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                    <ComboBox x:Name="CmbCanDeviceFilter" Grid.Column="7"
                          SelectionChanged="CmbCanFilters_SelectionChanged">
                    <ComboBoxItem Content="Both" IsSelected="True"/>
                    <ComboBoxItem Content="OSRAM"/>
                    <ComboBoxItem Content="NICHIA"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Select to show:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                    <ComboBox x:Name="CmbCanOpFilter" Grid.Column="1" SelectionChanged="CmbCanFilters_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="R"/>
                        <ComboBoxItem Content="W"/>
                    </ComboBox>

                    <TextBlock Grid.Column="3" Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#666666"/>
                    <ComboBox x:Name="CmbCanStatusFilter" Grid.Column="4" SelectionChanged="CmbCanFilters_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="OK"/>
                        <ComboBoxItem Content="Error"/>
                    </ComboBox>

                    <Button x:Name="BtnCanClear" Grid.Column="6" Content="Clear" Click="BtnCanClear_Click" Padding="10,4"/>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="BtnCanRecord" Content="⏺ Record" Click="BtnCanRecord_Click" Padding="10,4" Margin="0,0,4,0"
                                Background="#F6F6F6" Foreground="#444444" BorderBrush="#D8D8D8" BorderThickness="1"/>
                        <Button x:Name="BtnCanStopRecord" Content="⏹ Stop" Click="BtnCanStopRecord_Click" Padding="10,4"
                                Background="#F6F6F6" Foreground="#444444" BorderBrush="#D8D8D8" BorderThickness="1" IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Monitor view (default visible) -->
                <ListView x:Name="LvCanDiag" Grid.Row="3" Margin="0,0,0,8"
                          MouseDoubleClick="LvCanDiag_MouseDoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Timestamp}" Width="86"/>
                            <GridViewColumn Header="Nr" DisplayMemberBinding="{Binding Number}" Width="44"/>
                            <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="96"/>
                            <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="72"/>
                            <GridViewColumn Header="MemoryType" DisplayMemberBinding="{Binding MemoryType}" Width="78"/>
                            <GridViewColumn Header="Device" DisplayMemberBinding="{Binding Device}" Width="68"/>
                            <GridViewColumn Header="R/W" DisplayMemberBinding="{Binding Operation}" Width="44"/>
                            <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="130"/>
                            <GridViewColumn Header="Error" DisplayMemberBinding="{Binding Error}" Width="80"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Error}" Value="Timeout">
                                    <Setter Property="Background" Value="#FFEEEE"/>
                                    <Setter Property="Foreground" Value="#CC0000"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Error}" Value="CRC">
                                    <Setter Property="Background" Value="#FFF3CC"/>
                                    <Setter Property="Foreground" Value="#886600"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- RawCan view (hidden by default) -->
                <ScrollViewer x:Name="ScvRawCan" Grid.Row="3" Margin="0,0,0,8"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#1E1E1E">
                    <TextBlock x:Name="TblRawCan" FontFamily="Consolas" FontSize="11"
                               Foreground="#D4D4D4" Padding="8,6"
                               TextWrapping="Wrap"/>
                </ScrollViewer>

                <!-- UartTransaction view (hidden by default) -->
                <Grid x:Name="GridUartTx" Grid.Row="3" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock Text="UartTransaction view — coming soon." Foreground="#888888"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LblCanMonitorStatus" Grid.Column="0"
                               Foreground="DimGray" TextWrapping="Wrap"
                               Text="Waiting for live diagnostic packets."/>

                    <TextBlock x:Name="LblCanPageInfo" Grid.Column="1" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,8,0"
                               Text="Page: 1 / 1"/>
                    <TextBox x:Name="TxtCanPageJump" Grid.Column="2" Width="50" Padding="4,2" Margin="0,0,6,0"
                             VerticalAlignment="Center" HorizontalContentAlignment="Center"
                             KeyDown="TxtCanPageJump_KeyDown"/>
                    <Button x:Name="BtnCanPrevPage" Grid.Column="3" Content="Previous" Click="BtnCanPrevPage_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button x:Name="BtnCanNextPage" Grid.Column="4" Content="Next" Click="BtnCanNextPage_Click" Padding="12,4"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Right side bottom: LVDS Info + Status -->
        <Grid x:Name="SidebarInfo" Grid.Row="2" Grid.RowSpan="3" Grid.Column="2" Margin="4,4,4,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- LVDS Info -->
            <GroupBox Grid.Row="0" Header="LVDS Info" Padding="8" Margin="0,0,0,8" Background="#F0F0F0">
                <StackPanel Orientation="Vertical">
                    <!-- LVDS Protocol details (auto-detected from LSM device type) -->
                    <TextBlock x:Name="LblLvdsProtocol" TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,0"
                               Text=""/>

                    <!-- Separator (LVDS information) -->
                    <Rectangle Height="1" Fill="Gray" Margin="0,8,0,8" HorizontalAlignment="Stretch"/>

                    <!-- Frame Statistics -->
                    <TextBlock Text="Frame Statistics" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="LblLvdsFrameCount" Text="Frames: 0" Foreground="DimGray"/>
                    <TextBlock x:Name="LblLvdsBytesReceived" Text="Bytes: 0" Foreground="DimGray"/>
                    <TextBlock x:Name="LblLvdsSyncLoss" Text="Sync losses: 0" Foreground="DimGray"/>
                    <TextBlock x:Name="LblLvdsFps" Text="FPS: --" Foreground="DimGray"/>
                </StackPanel>
            </GroupBox>

            <!-- Status -->
            <GroupBox Grid.Row="1" Header="Status" Padding="8" Background="#F0F0F0">
                <StackPanel Orientation="Vertical">
                    <TextBlock x:Name="LblStatus" TextWrapping="Wrap" Foreground="DimGray"/>
                    <TextBlock x:Name="LblDiffStats" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="DimGray" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="AVTP in:" Margin="0,0,6,0" />
                        <TextBlock x:Name="LblAvtpInFps" Margin="0,0,16,0" />
                        <TextBlock Text="Dropped:" Margin="0,0,6,0" />
                        <TextBlock x:Name="LblAvtpDropped" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Button Bar (under pane D) -->
        <Grid x:Name="ButtonBar" Grid.Row="3" Grid.ColumnSpan="2" Margin="4,6,4,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnLoadFiles" Content="Load Files…" Click="BtnLoadFiles_Click" Padding="10,4" />
                <Rectangle Width="1" Height="26" Fill="Gray" Margin="12,0,12,0" VerticalAlignment="Center" />

                <!-- Player buttons (keep order): Start Prev Next Record Stop -->
                <Button x:Name="BtnStart" Content="▶ Start" Click="BtnStart_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnPrev" Content="⏮ Prev" Click="BtnSeqPrev_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnNext" Content="⏭ Next" Click="BtnSeqNext_Click" Padding="10,4" Margin="0,0,6,0"/>
                <Button x:Name="BtnRecord" Content="⏺ Record" Click="BtnRecord_Click" Padding="10,4" Margin="0,0,6,0" />
                <Button x:Name="BtnStop" Content="⏹ Stop" Click="BtnStop_Click" Padding="10,4" Margin="0,0,0,0" />

                <!-- Separate action: Snapshot (placed to the right, with a vertical separator) -->
                <Rectangle Width="1" Height="26" Fill="Gray" Margin="12,0,12,0" VerticalAlignment="Center" />
                <Button x:Name="BtnSave" Content="📷 Snapshot" Click="BtnSaveReport_Click" Padding="10,4" />

                <Button x:Name="BtnOpenSnapshots" Click="BtnOpenSnapshots_Click" Padding="6,4" Margin="6,0,0,0"
                        ToolTip="Open frameSnapshots folder">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE8B7;" />
                </Button>

                <!-- Loop checkbox (visible only for AVI/PCAP) -->
                <Rectangle Width="1" Height="26" Fill="Gray" Margin="12,0,12,0" VerticalAlignment="Center" />
                <CheckBox x:Name="ChkLoopPlaying" Content="🔄 Loop Playback" VerticalAlignment="Center"
                          Visibility="Collapsed" IsChecked="False" Checked="ChkLoopPlaying_Changed" Unchecked="ChkLoopPlaying_Changed" />

                <TextBlock x:Name="LblSaveFeedback"
                           Text=""
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="DimGray"
                           TextTrimming="CharacterEllipsis"
                           MinWidth="220" />
            </StackPanel>
            <!-- Horizontal separator below buttons -->
            <Rectangle Grid.Row="1" Height="1" Fill="Gray" Margin="10,6,10,0" HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Comparison Options (under buttons) -->
        <Border x:Name="ComparisonBar" Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="6" Margin="4,8,4,4" Padding="10,6" Background="#F8F8F8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Comparison Options" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Rectangle Width="1" Height="22" Fill="#ABADB3" Margin="0,0,16,0" VerticalAlignment="Center"/>

                <!-- Comparison Mode -->
                <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbComparisonMode" Width="130" SelectedIndex="0" SelectionChanged="CmbComparisonMode_SelectionChanged">
                    <ComboBoxItem Content="LVDS-AVTP"/>
                    <ComboBoxItem Content="LSM-LVDS"/>
                    <ComboBoxItem Content="LSM-AVTP"/>
                </ComboBox>

                <Rectangle Width="1" Height="22" Fill="#ABADB3" Margin="16,0,16,0" VerticalAlignment="Center"/>

                <!-- Deviation threshold -->
                <TextBlock Text="Dev. threshold:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Border BorderBrush="#ABADB3" BorderThickness="1" Background="White" CornerRadius="2">
                    <Grid Width="60" Height="24">
                        <TextBox x:Name="TxtDiffThr" Text="0" 
                                 BorderThickness="0" 
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 Padding="4,0,24,0"
                                 TextChanged="TxtDiffThr_TextChanged"/>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="18">
                            <RepeatButton x:Name="BtnDiffThrUp" Content="▲" 
                                        FontSize="6" 
                                        Height="12" 
                                        Padding="0" 
                                        BorderThickness="0,0,0,0.5"
                                        Click="BtnDiffThrUp_Click"/>
                            <RepeatButton x:Name="BtnDiffThrDown" Content="▼" 
                                        FontSize="6" 
                                        Height="12" 
                                        Padding="0" 
                                        BorderThickness="0"
                                        Click="BtnDiffThrDown_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Rectangle Width="1" Height="22" Fill="#ABADB3" Margin="16,0,16,0" VerticalAlignment="Center"/>

                <!-- Flip white/black comparison -->
                <CheckBox x:Name="ChkZeroZeroWhite" IsChecked="False" VerticalAlignment="Center"
                          ToolTip="When enabled: 0=0 → white, 255=255 → black"
                          Checked="ChkZeroZeroWhite_Changed" Unchecked="ChkZeroZeroWhite_Changed">
                    <TextBlock Text="Flip (0=0→white, 255=255→black)" />
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Hidden Configuration Panels (used by popup windows via re-parenting) -->
        <StackPanel x:Name="HiddenConfigPanel" Visibility="Collapsed">
            <!-- 1. Hardware Configuration -->
            <GroupBox x:Name="GrpHardwareConfig" Header="Hardware Configuration" Padding="10" Margin="8">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Mode of Operation:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbModeOfOperation" Width="160" SelectedIndex="0" SelectionChanged="CmbModeOfOperation_SelectionChanged">
                            <ComboBoxItem Content="AVTP Monitoring"/>
                            <ComboBoxItem Content="AVTP Generator"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="LSM Device Type:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLsmDeviceType" Width="160" SelectedIndex="0" SelectionChanged="CmbLsmDeviceType_SelectionChanged">
                            <ComboBoxItem Content="Osram 2.0"/>
                            <ComboBoxItem Content="Osram 2.05"/>
                            <ComboBoxItem Content="Nichia"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="ECU Variant:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbEcuVariant" Width="160" SelectedIndex="0" SelectionChanged="CmbEcuVariant_SelectionChanged">
                            <ComboBoxItem Content="MB PLU-HD 1.0 LH"/>
                            <ComboBoxItem Content="MB PLU-HD 1.0 RH"/>
                            <ComboBoxItem Content="MB PLU-HD 2.0 LH"/>
                            <ComboBoxItem Content="MB PLU-HD 2.0 RH"/>
                            <ComboBoxItem Content="MB CHLC 1.0"/>
                            <ComboBoxItem Content="MB CHLC 2.0"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <TextBlock Text="LVDS Mode:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLvdsMode" Width="160" SelectedIndex="0" SelectionChanged="CmbLvdsMode_SelectionChanged">
                            <ComboBoxItem Content="LVDS Monitoring"/>
                            <ComboBoxItem Content="LVDS Generator"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 2. Application Settings -->
            <GroupBox x:Name="GrpAppSettings" Header="Application Settings" Padding="10" Margin="8">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="FPS:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtFps" Width="60" Text="100"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Deviation value:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtBDelta" Width="60" Text="0" TextChanged="BDelta_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Dead pixel ID:" VerticalAlignment="Center" Width="110" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtDeadPixelId" Width="60" Text="0" TextChanged="TxtDeadPixelId_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <CheckBox x:Name="ChkDarkPixelComp" Content="Dark pixel compensation" IsChecked="False" VerticalAlignment="Center"
                                  ToolTip="Boost neighbors around dark pixels: +15% (N/S/E/W), +10% (diagonals), +5% (2-step N/S/E/W)"
                                  Checked="ChkDarkPixelComp_Changed" Unchecked="ChkDarkPixelComp_Changed" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- 3. Ethernet Configuration -->
            <GroupBox x:Name="GrpEthernetConfig" Header="Ethernet Configuration" Padding="10" Margin="8">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="NIC:" VerticalAlignment="Center" Width="88" Margin="0,0,4,0"/>
                        <ComboBox x:Name="CmbLiveNic" Width="236" SelectionChanged="CmbLiveNic_SelectionChanged" Margin="0,0,4,0"/>
                        <Button Content="Refresh" Click="BtnRefreshNics_Click" Padding="6,4" Width="56"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Source MAC:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtSrcMac" Width="116" Text="3C:CE:15:00:00:19" TextChanged="TxtMac_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="Dest MAC:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtDstMac" Width="116" Text="01:00:5E:16:00:12" TextChanged="TxtMac_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="VLAN ID:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtVlanId" Width="60" Text="70" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="802.1Q VLAN ID (0-4095)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="VLAN Priority:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtVlanPriority" Width="60" Text="5" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="802.1Q Priority Code Point (0-7)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                        <TextBlock Text="AVTP EtherType:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtAvtpEtherType" Width="60" Text="0x22F0" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="AVTP EtherType (hex, e.g. 0x22F0)"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <TextBlock Text="Stream ID byte:" VerticalAlignment="Center" Width="85" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtStreamIdLastByte" Width="60" Text="0x50" TextChanged="TxtAvtpHeader_TextChanged"
                                 ToolTip="Last byte of AVTP Stream ID (hex, e.g. 0x50)"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        </Grid>
    </DockPanel>
</Window>

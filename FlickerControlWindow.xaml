<Window x:Class="VilsSharpX.FlickerControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flicker Monitoring and Control"
        Width="620" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Enable Flicker Detection and Monitoring:" VerticalAlignment="Center" FontWeight="SemiBold" />
            <Grid x:Name="EnableControlHost" Margin="10,0,0,0" />
            <TextBlock x:Name="EnableStateText" Text="Disabled" VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0" />
        </StackPanel>

        <GroupBox Grid.Row="1" Padding="10" Margin="0,0,0,10">
            <GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0" />
                        <TextBlock Text="Flicker Monitoring" FontWeight="Bold" Foreground="Black" />
                    </StackPanel>
                    <Border x:Name="StatusBadge" Grid.Column="1" Background="#EDEDED" CornerRadius="12" Padding="9,3">
                        <TextBlock x:Name="StatusHeaderText" Text="Idle" Foreground="#666666" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView x:Name="FlickerEventLog" Grid.Row="0" Height="180"
                          FontFamily="Consolas" FontSize="11"
                          SelectionMode="Single"
                          GridViewColumnHeader.Click="FlickerEventLog_ColumnHeaderClick"
                          PreviewKeyDown="FlickerEventLog_PreviewKeyDown"
                          PreviewMouseRightButtonDown="FlickerEventLog_PreviewMouseRightButtonDown"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Time" DisplayMemberBinding="{Binding Time}" Width="90" />
                            <GridViewColumn Header="Status" DisplayMemberBinding="{Binding Status}" Width="82" />
                            <GridViewColumn Header="Metric" DisplayMemberBinding="{Binding Metric}" Width="80" />
                            <GridViewColumn Header="Frames" DisplayMemberBinding="{Binding Frames}" Width="70" />
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="CopyFlickerLogMenuItem_Click" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="ClearFlickerLogButton" Content="Clear" Click="ClearFlickerLogButton_Click"
                            Padding="12,4" Margin="0,0,6,0" />
                    <Button x:Name="SaveFlickerLogButton" Content="💾 Save" Click="SaveFlickerLogButton_Click"
                            Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="OpenFlickerFolderButton" Content="📂" Click="OpenFlickerFolderButton_Click"
                            Padding="8,4" ToolTip="Open Flicker detections folder" />
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Padding="10" Margin="0,0,0,10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚡" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0" />
                    <TextBlock Text="Flicker Control" FontWeight="Bold" Foreground="Black" />
                </StackPanel>
            </GroupBox.Header>
            <Grid x:Name="InjectionControlsHost" Margin="0,4,0,0" />
        </GroupBox>

        <GroupBox Grid.Row="3" Padding="10" Margin="0,0,0,10">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ⓘ" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0" />
                    <TextBlock Text="Info" FontWeight="Bold" Foreground="Black" />
                </StackPanel>
            </GroupBox.Header>
            <TextBlock x:Name="InfoText" MinHeight="18" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
        </GroupBox>

    </Grid>
</Window>

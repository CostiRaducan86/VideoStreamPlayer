<Window x:Class="VilsSharpX.CanDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diagnostic Record Detail"
        Width="640" Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#F8F8F8"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinWidth" Value="130"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#1EA6E6"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <TextBlock x:Name="TxtTitle" Grid.Row="0"
                   FontSize="14" FontWeight="SemiBold"
                   Foreground="#1EA6E6" Margin="0,0,0,12"
                   Text="Diagnostic Record"/>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">

                <!-- ── Timing section ── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Timing"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Time:"/>
                    <TextBox x:Name="TxtTime" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="UnixTs(us):"/>
                    <TextBox x:Name="TxtUnixTs" Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="ResponseDelay:"/>
                    <TextBox x:Name="TxtResponseDelay" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="InterFrameDelay:"/>
                    <TextBox x:Name="TxtInterFrameDelay" Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueStyle}"/>
                </Grid>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,0"/>

                <!-- ── Identity section ── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Identity"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Nr:"/>
                    <TextBox x:Name="TxtNr" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="Name:"/>
                    <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Address:"/>
                    <TextBox x:Name="TxtAddress" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="MemoryType:"/>
                    <TextBox x:Name="TxtMemoryType" Grid.Row="1" Grid.Column="3" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Device:"/>
                    <TextBox x:Name="TxtDevice" Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="R/W:"/>
                    <TextBox x:Name="TxtRw" Grid.Row="2" Grid.Column="3" Style="{StaticResource ValueStyle}"/>
                </Grid>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,0"/>

                <!-- ── Diagnostics section ── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Diagnostics"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Crc:"/>
                    <TextBox x:Name="TxtCrc" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}" Margin="0,0,16,4"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelStyle}" Text="Error:"/>
                    <TextBox x:Name="TxtError" Grid.Row="0" Grid.Column="3" Style="{StaticResource ValueStyle}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Description:"/>
                    <TextBox x:Name="TxtDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                               Style="{StaticResource ValueStyle}" TextWrapping="Wrap"/>
                </Grid>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,0"/>

                <!-- ── Raw / Value section ── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Data"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Value:"/>
                    <TextBox x:Name="TxtValue" Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueStyle}"
                               FontFamily="Consolas" Margin="0,0,0,4"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelStyle}" Text="Raw (hex):"/>
                    <TextBox x:Name="TxtRaw" Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueStyle}"
                               FontFamily="Consolas" TextWrapping="Wrap"/>
                </Grid>

                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,0"/>

                <!-- ── Nested registers section ── -->
                <TextBlock Style="{StaticResource SectionHeader}" Text="Nested (decoded registers)"/>
                <Border Background="#1E1E1E" CornerRadius="4" Padding="10,8">
                    <TextBox x:Name="TxtNested" FontFamily="Consolas" FontSize="11"
                               Foreground="#D4D4D4" TextWrapping="Wrap"
                               IsReadOnly="True" BorderThickness="0"
                               Background="Transparent"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="2" Content="Close" Click="BtnClose_Click"
                HorizontalAlignment="Right" Padding="20,6" Margin="0,12,0,0"/>
    </Grid>
</Window>

<Window x:Class="VilsSharpX.CommunicationFaultControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Communication Fault Injection Control"
        Width="560" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Communication Fault Injection"
                   FontSize="16" FontWeight="Bold"
                   Foreground="DarkBlue" Margin="0,0,0,8"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Select a communication path to interrupt. AVTP is currently available in AVTP Generator stop/black-frame mode; LVDS and CAN-UART are reserved for firmware support."/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="AvtpFaultCheckBox" Grid.Column="0" Content="AVTP Communication Fault" VerticalAlignment="Center"/>
            <TextBlock x:Name="AvtpStatusText" Grid.Column="1" Text="[Disabled]" VerticalAlignment="Center" Foreground="DarkRed"/>
            <TextBlock Grid.Column="2" Text="Generator black frames" VerticalAlignment="Center" Foreground="Gray"/>
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="LvdsFaultCheckBox" Grid.Column="0" Content="LVDS Communication Fault" VerticalAlignment="Center" IsEnabled="False"/>
            <TextBlock Grid.Column="1" Text="[Firmware pending]" VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="AURIX GPIO/TX control" VerticalAlignment="Center" Foreground="Gray"/>
        </Grid>

        <Grid Grid.Row="4" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="CanUartFaultCheckBox" Grid.Column="0" Content="CAN-UART Communication Fault" VerticalAlignment="Center" IsEnabled="False"/>
            <TextBlock Grid.Column="1" Text="[Firmware pending]" VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock Grid.Column="2" Text="AURIX bridge TX control" VerticalAlignment="Center" Foreground="Gray"/>
        </Grid>
    </Grid>
</Window>
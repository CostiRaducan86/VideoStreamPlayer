<Window x:Class="VilsSharpX.CommunicationFaultControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Communication Fault Injection Control"
        Width="545" Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Communication Fault Injection"
                   FontSize="16" FontWeight="Bold"
                   Foreground="DarkBlue" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#444444"
                   Text="Inject controlled communication interruptions between ECU, LSM and SmartVisio."/>

        <GroupBox Grid.Row="2" Padding="10" Margin="0,0,0,8">
            <GroupBox.Header>
                <Grid Width="495">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⇄" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0"/>
                        <TextBlock FontWeight="Bold" Foreground="#222222" Text="AVTP / Ethernet"/>
                    </StackPanel>
                    <Border x:Name="AvtpStatusBadge" HorizontalAlignment="Right" Background="#D9EAD3" CornerRadius="8" Padding="8,3">
                        <TextBlock x:Name="AvtpStatusText" FontWeight="Bold" Foreground="#2E6B2E" Text="● READY"/>
                    </Border>
                </Grid>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock FontWeight="Bold" Foreground="Gray" Text="Suspend AVTP packet transmission"/>
                    <TextBlock x:Name="AvtpCountdownText" HorizontalAlignment="Right" Margin="0,0,0,0" FontWeight="Bold" Foreground="DarkRed" Visibility="Collapsed"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="88"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="AvtpDurationLabel" VerticalAlignment="Center" Text="Fault Duration:" Margin="0,0,8,0"/>
                    <Border x:Name="AvtpDurationBorder" Grid.Column="1" Width="64" Height="20" HorizontalAlignment="Left" BorderBrush="#ABADB3" BorderThickness="1" Background="White" CornerRadius="2">
                        <Grid Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" ClipToBounds="True">
                            <TextBox x:Name="AvtpDurationTextBox" Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" Text="2000" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="4,0,16,0"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="18" MinWidth="16" MaxWidth="16" MinHeight="18" MaxHeight="18" Panel.ZIndex="1">
                                <RepeatButton x:Name="AvtpDurationUpButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▲" FontSize="6" Padding="0" BorderThickness="0"/>
                                <RepeatButton x:Name="AvtpDurationDownButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▼" FontSize="6" Padding="0" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="AvtpDurationUnit" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0" Text="ms"/>
                    <Button x:Name="AvtpInjectButton" Grid.Column="4" Width="96" Height="28" Content="Inject Fault" Background="DodgerBlue" Foreground="White"/>
                    <Button x:Name="AvtpStopButton" Grid.Column="4" Width="96" Height="28" Content="Stop" Background="#C62828" Foreground="White" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Padding="10" Margin="0,0,0,8">
            <GroupBox.Header>
                <Grid Width="495">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0"/>
                        <TextBlock FontWeight="Bold" Foreground="#222222" Text="LVDS / Video Link"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#FCE5CD" CornerRadius="8" Padding="8,3" ToolTip="Firmware support is pending.">
                        <TextBlock FontWeight="Bold" Foreground="#B45F06" Text="● PENDING"/>
                    </Border>
                </Grid>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="Gray" Text="Interrupt LVDS frames between ECU and LSM"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,12,0,0" IsEnabled="False" Opacity="0.55">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="Fault Duration:" Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Width="64" Height="20" HorizontalAlignment="Left" BorderBrush="#ABADB3" BorderThickness="1" Background="White" CornerRadius="2" IsEnabled="False">
                        <Grid Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" ClipToBounds="True">
                            <TextBox x:Name="LvdsDurationTextBox" Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" Text="2000" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="4,0,16,0"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="18" MinWidth="16" MaxWidth="16" MinHeight="18" MaxHeight="18" Panel.ZIndex="1">
                                <RepeatButton x:Name="LvdsDurationUpButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▲" FontSize="6" Padding="0" BorderThickness="0"/>
                                <RepeatButton x:Name="LvdsDurationDownButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▼" FontSize="6" Padding="0" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray" Text="ms"/>
                    <Button Grid.Column="4" Width="96" Height="28" Content="Inject Fault"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="4" Padding="10" Margin="0,0,0,8">
            <GroupBox.Header>
                <Grid Width="495">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="↔" FontWeight="Bold" Foreground="DarkBlue" Margin="0,0,5,0"/>
                        <TextBlock FontWeight="Bold" Foreground="#222222" Text="CAN-UART / Control Link"/>
                    </StackPanel>
                    <Border HorizontalAlignment="Right" Background="#FCE5CD" CornerRadius="8" Padding="8,3" ToolTip="Firmware support is pending.">
                        <TextBlock FontWeight="Bold" Foreground="#B45F06" Text="● PENDING"/>
                    </Border>
                </Grid>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="Bold" Foreground="Gray" Text="Interrupt CAN-UART messages between ECU and LSM"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,12,0,0" IsEnabled="False" Opacity="0.55">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="88"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Foreground="Gray" Text="Fault Duration:" Margin="0,0,8,0"/>
                    <Border Grid.Column="1" Width="64" Height="20" HorizontalAlignment="Left" BorderBrush="#ABADB3" BorderThickness="1" Background="White" CornerRadius="2" IsEnabled="False">
                        <Grid Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" ClipToBounds="True">
                            <TextBox x:Name="CanUartDurationTextBox" Width="62" Height="18" MinWidth="62" MaxWidth="62" MinHeight="18" MaxHeight="18" Text="2000" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="4,0,16,0"/>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="18" MinWidth="16" MaxWidth="16" MinHeight="18" MaxHeight="18" Panel.ZIndex="1">
                                <RepeatButton x:Name="CanUartDurationUpButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▲" FontSize="6" Padding="0" BorderThickness="0"/>
                                <RepeatButton x:Name="CanUartDurationDownButton" Width="16" Height="9" MinWidth="16" MaxWidth="16" MinHeight="9" MaxHeight="9" Content="▼" FontSize="6" Padding="0" BorderThickness="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray" Text="ms"/>
                    <Button Grid.Column="4" Width="96" Height="28" Content="Inject Fault"/>
                </Grid>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="5" Header="Info" Padding="10" MinHeight="62">
            <TextBlock x:Name="FaultInfoText" Foreground="Gray" TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>
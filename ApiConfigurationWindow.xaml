<Window
    x:Class="VilsSharpX.ApiConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="API Configuration"
    Width="520" Height="580"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Padding="20">
    <DockPanel LastChildFill="True">
        <!-- OK button at the bottom, centered (same style as Hardware Configuration) -->
        <Button x:Name="BtnOK" DockPanel.Dock="Bottom" Content="OK" 
                Padding="24,4,24,4" HorizontalAlignment="Center" Margin="0,8,0,8"
                Click="BtnOK_Click" />

        <StackPanel Orientation="Vertical" Margin="10">
            
            <!-- Remote Access Section -->
            <GroupBox Header="Remote Access" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="ChkAllowRemote" Content="Allow Remote Access" VerticalAlignment="Center" Margin="0,0,0,8" />
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Bind Address:" Width="100" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtBindAddress" Width="200" Padding="4,2" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Port:" Width="100" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPort" Width="80" Padding="4,2" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- API Key Section -->
            <GroupBox Header="API Key" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="TxtApiKey" Width="350" Padding="4,2" IsReadOnly="True" 
                                 Foreground="Gray" Background="#F0F0F0" VerticalAlignment="Center" />
                        <Button x:Name="BtnToggleShowPassword" Width="32" Height="26" Margin="8,0,0,0"
                                ToolTip="Show/Hide" Click="BtnToggleShowPassword_Click" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtEyeIcon" Text="👁" FontSize="14" />
                        </Button>
                    </StackPanel>
                    
                    <Button x:Name="BtnGenerateKey" Padding="12,4,12,4" Content="Generate Key" 
                            Click="BtnGenerateKey_Click" HorizontalAlignment="Left" Margin="0,0,0,8" />
                    
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                        Note: Generating a new key will invalidate the previous token immediately. 
                        Remote clients must use the new token.
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Allowed CIDRs Section -->
            <GroupBox Header="Allowed CIDR Ranges" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        Remote IPs outside these ranges will be rejected (e.g., 10.168.50.0/24)
                    </TextBlock>
                    
                    <ListBox x:Name="LstCidrs" Height="100" Margin="0,0,0,8" />
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtNewCidr" Width="200" Padding="4,2" VerticalAlignment="Center" />
                        <Button x:Name="BtnAddCidr" Padding="12,4,12,4" Content="Add" Click="BtnAddCidr_Click" Margin="8,0,0,0" />
                        <Button x:Name="BtnRemoveCidr" Padding="12,4,12,4" Content="Remove" Click="BtnRemoveCidr_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>

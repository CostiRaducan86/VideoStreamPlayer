<Window
    x:Class="VilsSharpX.ApiConfigurationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="API Configuration"
    Width="520" Height="620"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Padding="20">
    <DockPanel LastChildFill="True">
        <!-- OK button at the bottom, centered (same style as Hardware Configuration) -->
        <Button x:Name="BtnOK" DockPanel.Dock="Bottom" Content="OK" 
                Padding="24,4,24,4" HorizontalAlignment="Center" Margin="0,8,0,8"
                Click="BtnOK_Click" />

        <StackPanel Orientation="Vertical" Margin="10">
            
            <!-- Remote Access Section -->
            <GroupBox Header="Remote Access" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    <CheckBox x:Name="ChkAllowRemote" Content="Allow Remote Access" VerticalAlignment="Center" Margin="0,0,0,8" />
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="Bind Address:" Width="100" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtBindAddress" Width="200" Padding="4,2" VerticalAlignment="Center" />
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Port:" Width="100" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPort" Width="80" Padding="4,2" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- API Key Section -->
            <GroupBox Header="API Key" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    
                    <!-- Key field with embedded eye button -->
                    <Border BorderBrush="#ABADB3" BorderThickness="1" CornerRadius="2" Margin="0,0,0,8"
                            Background="White" Height="28">
                        <Grid>
                            <TextBox x:Name="TxtApiKey" Padding="4,2,40,2" IsReadOnly="True" 
                                     Foreground="Gray" Background="Transparent" BorderThickness="0"
                                     VerticalAlignment="Center" />
                            <Button x:Name="BtnToggleShowPassword" Width="38" Height="26"
                                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTip="Show/Hide" Click="BtnToggleShowPassword_Click" Cursor="Hand">
                                <Viewbox Width="22" Height="18">
                                    <Canvas x:Name="EyeCanvas" Width="24" Height="24">
                                        <!-- Open eye icon -->
                                        <Path x:Name="EyeOpenPath" Fill="#555" Data="M12,4.5C7,4.5 2.73,7.61 1,12c1.73,4.39 6,7.5 11,7.5s9.27,-3.11 11,-7.5c-1.73,-4.39 -6,-7.5 -11,-7.5zM12,17c-2.76,0 -5,-2.24 -5,-5s2.24,-5 5,-5 5,2.24 5,5 -2.24,5 -5,5zM12,9c-1.66,0 -3,1.34 -3,3s1.34,3 3,3 3,-1.34 3,-3 -1.34,-3 -3,-3z" />
                                        <!-- Slash line for hidden state -->
                                        <Line x:Name="EyeSlashLine" X1="4" Y1="20" X2="20" Y2="4" Stroke="#555" StrokeThickness="2.2" Visibility="Visible" />
                                    </Canvas>
                                </Viewbox>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="BtnGenerateKey" Padding="12,4,12,4" Content="Generate Key" 
                                Click="BtnGenerateKey_Click" />
                        <Button x:Name="BtnCopyKey" Padding="12,4,12,4" Content="Copy" Margin="8,0,0,0"
                                Click="BtnCopyKey_Click" Visibility="Collapsed" />
                    </StackPanel>
                    
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap">
                        Note: Generating a new key will invalidate the previous token immediately. 
                        Remote clients must use the new token.
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- Allowed CIDRs Section -->
            <GroupBox Header="Allowed CIDR Ranges" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Vertical">
                    <TextBlock Foreground="Gray" FontSize="11" Margin="0,0,0,8">
                        Remote IPs outside these ranges will be rejected (e.g., 10.168.50.0/24)
                    </TextBlock>
                    
                    <ListBox x:Name="LstCidrs" Height="120" Margin="0,0,0,8" />
                    
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtNewCidr" Width="200" Padding="4,2" VerticalAlignment="Center" />
                        <Button x:Name="BtnAddCidr" Padding="12,4,12,4" Content="Add" Click="BtnAddCidr_Click" Margin="8,0,0,0" />
                        <Button x:Name="BtnRemoveCidr" Padding="12,4,12,4" Content="Remove" Click="BtnRemoveCidr_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</Window>
